# Set to "true" to lock the deployment to the standalone demo viewer (/demo)
# with zero Supabase requirements:
VITE_DEMO_ONLY=false

# Full workspace credentials (required only when VITE_DEMO_ONLY is not true):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
